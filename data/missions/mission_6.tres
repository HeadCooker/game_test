[resource]
script = ExtResource("1")
id = "6"
title = "黑色黎明"
briefing = "指挥官：摧毁信标的代价是整个地面网络。我们也许能离开，但不是所有人。\n目标：守住十波、击败巢母并等待30秒发射。可选：核心以至少80%生命完成任务。\n巢母会召唤无合金奖励的援军，半血后加速，配置穿甲与范围火力。"
log_main = "《最后一次点火》\n指挥官：信标网络已经断开。渡鸦号离开了地面。被放弃的那些声音仍在最后一段录音里。"
log_optional = "《最后的灯》\n轮机长：发射场的灯一直亮到我们越过云层。我希望地面的人知道，我们没有忘记他们。"
waves = Array[ExtResource("w")]([SubResource("wave_0"), SubResource("wave_1"), SubResource("wave_2"), SubResource("wave_3"), SubResource("wave_4"), SubResource("wave_5"), SubResource("wave_6"), SubResource("wave_7"), SubResource("wave_8"), SubResource("wave_9")])
