[resource]
script = ExtResource("1")
id = "6"
title = "黑色黎明"
briefing = "指挥官：摧毁信标的代价是整个地面网络。我们也许能离开，但不是所有人。\n目标：守住六波、击败巢母并等待30秒发射。可选：核心以至少80%生命完成任务。\n巢母会召唤无合金奖励的援军，半血后加速，配置穿甲与范围火力。"
log_main = "《最后一次点火》\n指挥官：信标网络已经断开。渡鸦号离开了地面。被放弃的那些声音仍在最后一段录音里。"
log_optional = "《最后的灯》\n轮机长：发射场的灯一直亮到我们越过云层。我希望地面的人知道，我们没有忘记他们。"
waves = Array[ExtResource("w")]([SubResource("wave_0"), SubResource("wave_2"), SubResource("wave_4"), SubResource("wave_5"), SubResource("wave_7"), SubResource("wave_9")])
rocks = PackedVector2Array(4, 4, 4, 5, 4, 6, 4, 9, 4, 10, 4, 11, 23, 4, 23, 5, 23, 6, 23, 9, 23, 10, 23, 11)
forbidden = PackedVector2Array(10, 2, 11, 2, 12, 2, 13, 2, 14, 2, 15, 2, 16, 2, 17, 2)
marker = Vector2i(-1, -1)
mining_required = 0
optional_rule = "core80"
reward_tower = -1
reward_module = ""
tint = Color(0.13,0.1,0.1,1)
