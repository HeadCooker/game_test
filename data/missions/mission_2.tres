[resource]
script = ExtResource("1")
id = "2"
title = "最后一班接驳"
briefing = "舰载人工智能：这里的居住记录被删除了。接驳舱里仍有人。\n目标：守住八波，第2、5、8波完成分批接驳。可选：在金色格建炮塔并保护到结束，接回失联的一组。\n后半段出现重甲，火炮可以打击密集目标。"
log_main = "《乘客名册》\n舰载人工智能：接驳成功。那些人没有被登记为殖民者，他们被列在“试验消耗”一栏。"
log_optional = "《额外接驳》\n轮机长：观察哨引导了最后一组接驳舱。他们上船时，没有人问为什么我们来得这么晚。"
waves = Array[ExtResource("w")]([SubResource("wave_0"), SubResource("wave_1"), SubResource("wave_2"), SubResource("wave_3"), SubResource("wave_4"), SubResource("wave_5"), SubResource("wave_6"), SubResource("wave_7")])
