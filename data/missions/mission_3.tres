[resource]
script = ExtResource("1")
id = "3"
title = "深层回声"
briefing = "轮机长：推进器需要的矿物就在我们脚下。可钻机的回声像是某种回答。\n目标：守住五波，并由采矿机累计开采160合金（不扣除）。可选：结束时保有两台采矿机。\n第3波起地下突袭，观察裂隙预警，核心附近也需要火力。"
log_main = "《采矿回声》\n指挥官：虫群总是在钻头接触深层矿脉后改变方向。它们并非没有目的地冲过来。"
log_optional = "《双重回声》\n舰载人工智能：两台钻机收到完全相同的脉冲。整片矿床像是同一个生物的器官。"
waves = Array[ExtResource("w")]([SubResource("wave_0"), SubResource("wave_2"), SubResource("wave_4"), SubResource("wave_5"), SubResource("wave_7")])
rocks = PackedVector2Array(7, 3, 7, 4, 7, 5, 7, 10, 7, 11, 7, 12, 20, 3, 20, 4, 20, 5, 20, 10, 20, 11, 20, 12)
forbidden = PackedVector2Array(2, 8, 3, 8, 4, 8, 5, 8)
marker = Vector2i(-1, -1)
mining_required = 160
optional_rule = "two_miners"
reward_tower = 5
reward_module = "scout"
tint = Color(0.1,0.14,0.13,1)
