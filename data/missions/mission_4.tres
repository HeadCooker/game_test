[resource]
script = ExtResource("1")
id = "4"
title = "静默阵列"
briefing = "舰载人工智能：公司并非第一次来这里。阵列每天都在向地下发送信号。\n目标：守住九波。可选：在金色格建炮塔，作为观察哨保护至结束。\n腐蚀虫远程攻击建筑，卫虫会恢复护盾；电弧可快速破盾。"
log_main = "《静默协议》\n舰载人工智能：公司的记录证明他们知道群体意识的存在。信标不用于求救，而用于刺激它。"
log_optional = "《阵列旁路》\n指挥官：观察哨记录到一条没有写入公司的通讯链。信号源在我们的飞船上。"
waves = Array[ExtResource("w")]([SubResource("wave_0"), SubResource("wave_1"), SubResource("wave_2"), SubResource("wave_3"), SubResource("wave_4"), SubResource("wave_5"), SubResource("wave_6"), SubResource("wave_7"), SubResource("wave_8")])
rocks = PackedVector2Array(5, 3, 5, 12, 6, 3, 6, 12, 7, 3, 7, 12, 8, 3, 8, 12, 9, 3, 9, 12, 12, 3, 12, 12, 13, 3, 13, 12, 14, 3, 14, 12, 15, 3, 15, 12, 18, 3, 18, 12, 19, 3, 19, 12, 20, 3, 20, 12, 21, 3, 21, 12, 22, 3, 22, 12, 8, 6, 19, 9)
forbidden = PackedVector2Array()
marker = Vector2i(17, 10)
mining_required = 0
optional_rule = "marker"
reward_tower = 6
reward_module = "industry"
tint = Color(0.1,0.12,0.19,1)
