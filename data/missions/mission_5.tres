[resource]
script = ExtResource("1")
id = "5"
title = "证据焚毁"
briefing = "轮机长：实验室的自毁程序已经启动。我们没有时间复制所有数据。\n目标：守住六波；第3、6、9波完成分段解码。可选：保护金色格中的档案炮塔。\n出发前选择保存人员资料或实验证据；首次通关后选择固定。"
log_main = "《货物编号零》\n轮机长：渡鸦号的货舱就是最后一座信标。我们带来的不是殖民设备，而是一把插入星球的钥匙。"
log_optional = "《未焚毁的页码》\n轮机长：我们至少留下了这份索引。没有名字的死者终于可以被找到。"
waves = Array[ExtResource("w")]([SubResource("wave_0"), SubResource("wave_2"), SubResource("wave_4"), SubResource("wave_5"), SubResource("wave_7"), SubResource("wave_9")])
rocks = PackedVector2Array(6, 4, 6, 5, 6, 10, 6, 11, 21, 4, 21, 5, 21, 10, 21, 11)
forbidden = PackedVector2Array(10, 6, 10, 7, 10, 9, 10, 10, 11, 6, 11, 7, 11, 9, 11, 10, 16, 6, 16, 7, 16, 9, 16, 10, 17, 6, 17, 7, 17, 9, 17, 10)
marker = Vector2i(18, 8)
mining_required = 0
optional_rule = "marker"
reward_tower = -1
reward_module = "emergency"
tint = Color(0.15,0.1,0.14,1)
